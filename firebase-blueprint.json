{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "An AI-generated website architecture project with chat dialogue and generated single-file HTML code.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the project."
        },
        "user_id": {
          "type": "string",
          "description": "The author or session owner ID."
        },
        "title": {
          "type": "string",
          "description": "Title or business name of the website."
        },
        "style": {
          "type": "string",
          "description": "Visual theme and design DNA chosen."
        },
        "html": {
          "type": "string",
          "description": "Full production-ready single-file HTML code generated by AI."
        },
        "generating": {
          "type": "boolean",
          "description": "Whether an architectural generation pass is currently executing."
        },
        "template_id": {
          "type": "string",
          "description": "Base starter template identifier if cloned."
        },
        "share_token": {
          "type": "string",
          "description": "Public preview token for live client sharing."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the project was initiated."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the project was last revised."
        }
      },
      "required": ["id", "title", "created_at", "updated_at"]
    },
    "Template": {
      "title": "Template",
      "description": "Website starter template or imported user template available in the gallery.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the template."
        },
        "name": {
          "type": "string",
          "description": "Template title or branding."
        },
        "tagline": {
          "type": "string",
          "description": "Short marketing headline."
        },
        "service": {
          "type": "string",
          "description": "Industry category or service type."
        },
        "kind": {
          "type": "string",
          "enum": ["starter", "style", "import"],
          "description": "Template archetype or origin."
        },
        "owner_id": {
          "type": "string",
          "description": "Owner identifier for custom uploaded designs."
        },
        "html": {
          "type": "string",
          "description": "Single-file source HTML structure for preview and remixing."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the template was published or imported."
        }
      },
      "required": ["id", "name", "service", "kind"]
    },
    "Registration": {
      "title": "Registration",
      "description": "Official site and studio lead inquiry or VIP registration entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique registration entry ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email of subscriber."
        },
        "name": {
          "type": "string",
          "description": "Subscriber name or business."
        },
        "message": {
          "type": "string",
          "description": "Optional brief note or project requirements."
        },
        "source": {
          "type": "string",
          "description": "Campaign source or landing origin."
        },
        "app": {
          "type": "string",
          "enum": ["official_site", "studio", "levelstudio"],
          "description": "Application channel where registration occurred."
        },
        "status": {
          "type": "string",
          "enum": ["new", "reviewed", "contacted"],
          "description": "Workflow processing status."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of form submission."
        }
      },
      "required": ["id", "email", "created_at"]
    },
    "User": {
      "title": "User",
      "description": "Architect account or member profile.",
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "description": "Unique user identifier."
        },
        "email": {
          "type": "string",
          "description": "User email address."
        },
        "name": {
          "type": "string",
          "description": "User display name."
        },
        "picture": {
          "type": "string",
          "description": "Avatar image URL."
        },
        "role": {
          "type": "string",
          "enum": ["architect", "member", "admin"],
          "description": "User role."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of account registration."
        }
      },
      "required": ["user_id", "email", "name", "created_at"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "AI-generated sites and interactive workspace projects."
    },
    "/templates/{templateId}": {
      "schema": "Template",
      "description": "Curated starters and user-imported templates."
    },
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Official site and studio lead registrations (write-only for public, read for SuperAdmins)."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User account profiles."
    }
  }
}
